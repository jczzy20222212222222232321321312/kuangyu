# BSC testnet only. Never use a mainnet key.
BSC_TESTNET_RPC=https://bsc-testnet-rpc.publicnode.com
PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY
# Optional metadata base, must end with /
BASE_URI=
# Deployed test contract (BSC Testnet)
CONTRACT_ADDRESS=0x400e42D03dCf80D31fE45B57Daf3E0504a9dA240
# If you redeploy, replace the address above.

# ORE token / vault (BSC Testnet)
ORE_TOKEN_ADDRESS=0xa7a339C8E75B19669af2C9D3596C8B4f721c424d
ORE_VAULT_ADDRESS=0x7dEf540A66Bf6Ba6377cF43e4a31b1758d18c26c
# Claim signer service (server/claim-server.js)
CLAIM_SIGNER_FILE=/tmp/ore-zone-deployer.json
ORE_MINE_POOL=0x1C88b562556944FF9944eB58e69Ca21451aAA28a
CLAIM_PORT=8090

ORE_MARKET=0x32aFD90a939de46c2Ac7e94B16Bf556403918397

# Comma-separated browser origins. Same-origin tunnel traffic does not need CORS.
CORS_ORIGIN=http://127.0.0.1:8080,http://localhost:8080,http://192.168.10.108:8080
